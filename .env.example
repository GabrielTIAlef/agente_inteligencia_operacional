# Copie somente em instalação nova; nunca versione o .env preenchido.
# Crie um banco dedicado antes de iniciar. Não use conta administrativa em produção.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MONITOR_TOKEN=
MONITOR_GEMINI_ENABLED=false
MONITOR_GEMINI_MODEL=
MONITOR_NOTIFICATION_MODE=off
# Instalação n8n já inicializada: preservar a chave de ~/.n8n/config.
# Para uma instalação nova/Compose, definir uma chave própria antes do primeiro início.
N8N_ENCRYPTION_KEY=
