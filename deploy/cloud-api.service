[Unit]
Description=AI Operations API
After=network.target postgresql.service
Requires=postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=5
[Service]
User=aio
Group=aio
WorkingDirectory=/opt/aio
EnvironmentFile=/etc/aio/app.env
ExecStart=/opt/aio/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-proxy-headers --limit-concurrency 12 --timeout-keep-alive 5
Restart=on-failure
RestartSec=5
MemoryHigh=220M
MemoryMax=300M
TasksMax=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aio
[Install]
WantedBy=multi-user.target
